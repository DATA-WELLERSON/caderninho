# Local: Postgres do docker compose. Produção: string do pooler do Supabase (porta 6543).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/caderninho
# Opcional: DSN do projeto no Sentry. Vazio = Sentry desligado.
SENTRY_DSN=
# Liga GET /api/debug/erro, que lança uma exceção de propósito para testar o Sentry.
ENABLE_DEBUG_ROUTES=false
